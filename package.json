{
  "name": "ebola-rdc-voicebot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:next": "next dev",
    "build": "next build",
    "build:pages": "GITHUB_PAGES=true next build",
    "start": "next start",
    "test": "npm run validate && npm run build:pages && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate": "node scripts/validate-content.mjs",
    "build:agent": "node scripts/build-agent-package.mjs",
    "crop:visuals": "bash scripts/crop-visuals.sh",
    "create:agent": "node scripts/create-elevenlabs-agent.mjs --confirm-create",
    "update:agent": "node scripts/update-elevenlabs-agent.mjs --confirm-update"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.12.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  }
}
